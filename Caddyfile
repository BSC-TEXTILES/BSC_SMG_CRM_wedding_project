# BSC Textiles - Caddy Reverse Proxy Configuration
# Alternative to Nginx with automatic HTTPS via Let's Encrypt

{
    # Global options
    admin off
    auto_https disable_redirects
    
    # Email for Let's Encrypt
    email admin@bsctextiles.in
    
    # Default security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://www.google.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com; img-src 'self' data: blob: https: https://www.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' wss: https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://firebaselogging.googleapis.com https://www.googleapis.com https://generativelanguage.googleapis.com; media-src 'self' data: blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
        -Server
        -X-Powered-By
    }
}

# ─── Rate Limiting ─────────────────────────────────────────────────────
(rate_limit_auth) {
    rate_limit {
        zone auth_limit 10m
        key {remote_host}
        events 5
        window 1s
        penalty 30s
    }
}

(rate_limit_api) {
    rate_limit {
        zone api_limit 10m
        key {remote_host}
        events 30
        window 1s
        penalty 10s
    }
}

(rate_limit_general) {
    rate_limit {
        zone general_limit 10m
        key {remote_host}
        events 100
        window 1s
        penalty 5s
    }
}

# ─── Upstream Backend ──────────────────────────────────────────────────
(upstream_backend) {
    reverse_proxy {
        to 127.0.0.1:5000
        lb_policy least_conn
        health_uri /health
        health_interval 10s
        health_timeout 5s
        health_status 200
        
        # Connection pooling
        transport http {
            keepalive 32
            keepalive_timeout 30s
        }
    }
}

# ─── Main Site ─────────────────────────────────────────────────────────
bsctextiles.in, www.bsctextiles.in {
    encode zstd gzip
    
    # ─── Health Check (No Rate Limiting) ───────────────────────────────
    @health path /health /api/health
    handle @health {
        import upstream_backend
    }
    
    # ─── Authentication Endpoints (Strict Rate Limiting) ────────────────
    @auth path /api/auth/login /api/auth/verify-2fa /api/auth/resend-2fa /api/auth/lock-status /api/auth/captcha /api/auth/request-password-reset /api/auth/verify-password-reset-token /api/auth/reset-password /api/auth/send-verification /api/auth/verify-email /api/auth/resend-verification
    handle @auth {
        import rate_limit_auth
        import upstream_backend
    }
    
    # ─── API Endpoints (Moderate Rate Limiting) ────────────────────────
    @api path /api/*
    handle @api {
        import rate_limit_api
        import upstream_backend
    }
    
    # ─── Static Assets (Long-term Caching) ─────────────────────────────
    @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot *.map
    handle @static {
        import upstream_backend
        header Cache-Control "public, max-age=31536000, immutable"
        header Vary "Accept-Encoding"
    }
    
    # ─── Frontend Assets ───────────────────────────────────────────────
    @assets path /assets/*
    handle @assets {
        import upstream_backend
        header Cache-Control "public, max-age=2592000"
        header Vary "Accept-Encoding"
    }
    
    # ─── Main Application (SPA Fallback) ───────────────────────────────
    handle {
        import upstream_backend
        try_files {path} {path}/ /index.html
    }
    
    # ─── Security: Block sensitive files ───────────────────────────────
    @sensitive path /.git* /.env* /.htaccess /.htpasswd *.log *.sql *.bak *.backup *.config
    respond @sensitive 404
}

# ─── Optional: Admin Subdomain ────────────────────────────────────────
