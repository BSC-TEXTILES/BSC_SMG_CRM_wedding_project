# ─── Logging ───────────────────────────────────────────────────────────
{
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json {
            time_format "rfc3339"
        }
    }
    
    log {
        output file /var/log/caddy/error.log {
            roll_size 50mb
            roll_keep 5
            roll_keep_for 168h
        }
        level ERROR
    }
}