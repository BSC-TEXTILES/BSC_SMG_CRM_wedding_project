# BSC Textiles Management System - Frontend Environment Configuration
# Copy this file to .env and fill in values for your environment

# API Base URL
# For production: Set to your backend API URL (e.g., https://api.bsctextiles.in)
# For development with proxy: Use /api (vite will proxy to backend)
# For development without proxy: Use http://localhost:5000
VITE_API_URL=/api

# Application title
VITE_APP_TITLE=BSC Textiles Management System

# Frontend URL (used for tracking links, email links, etc.)
VITE_FRONTEND_URL=http://localhost:5173