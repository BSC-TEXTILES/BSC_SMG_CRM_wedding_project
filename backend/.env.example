# Backend Environment Configuration Template
# Copy this file to .env and fill in values for your environment

# Application
NODE_ENV=production
PORT=5000

# Cryptographic Keys (Server-side ONLY - 256-bit Hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_INDEPENDENT_64_CHAR_HEX_STRING
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_ENCRYPTION_KEY
COOKIE_SECURE=true

# Token Expiry Enforcements
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_HOURS=6

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# CORS Security Allowed Origins
CORS_ORIGINS=https://bsctextiles.in,https://www.bsctextiles.in
ALLOWED_ORIGINS=https://bsctextiles.in,https://www.bsctextiles.in

# Frontend URL (for tracking links, emails, etc.)
FRONTEND_URL=https://bsctextiles.in
TRACKING_URL=https://bsctextiles.in/track

# Storage Directory (MUST be persistent, outside app folder on production)
UPLOAD_DIR=/home/user/domains/bsctextiles.in/uploads

# Redis (Optional - for sessions, rate limiting, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_URL=
ENABLE_REDIS=false

# External AI Integrations (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Email Configuration (Resend - primary)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_NAME=BSC Textiles
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email Configuration (SMTP - fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Email Configuration (Legacy fallback names)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=BSC Textiles
EMAIL_FROM_ADDRESS=

# Default Account Passwords (initial seeding only - must be changed immediately)
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
DEFAULT_USER_PASSWORD=your_secure_default_user_password_min_12_chars
GREETER_PASSWORD=your_secure_greeter_password_min_12_chars

# API Key Encryption Key (optional, falls back to ENCRYPTION_KEY/JWT_SECRET)
API_KEY_KEK=