# ============================================================
# BSC Enterprise HRMS — Production Environment Variables
# ============================================================
# Copy this file to .env and fill in values for your server.
#
# CRITICAL: UPLOAD_DIR must point to a persistent directory
# OUTSIDE the application deployment folder, otherwise uploaded
# documents will be deleted on every deployment.
# ============================================================

# Application
NODE_ENV=production
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Secret
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cryptographic Keys (Server-side ONLY - 256-bit Hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a strong value is auto-generated on first boot and stored in
# server/config/.runtime-secrets.json (gitignored). Setting them explicitly
# is strongly recommended so tokens/encrypted data survive across servers.
ENCRYPTION_KEY=
COOKIE_SECURE=true

# Session & Captcha
# Absolute session lifetime in hours - users who never sign out are logged
# out automatically after this window (token + cookie + client timer).
SESSION_HOURS=6

# Token Expiry Enforcements
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Persistent Upload Directory (MUST be outside the app folder)
# Hostinger Production Directory:
UPLOAD_DIR=/home/u510366842/persistent_uploads_dvg

# CORS Security Allowed Origins (comma-separated, no wildcards in production)
CORS_ORIGINS=https://bsctextiles.in,https://www.bsctextiles.in
ALLOWED_ORIGINS=https://bsctextiles.in,https://www.bsctextiles.in

# Frontend URL (for tracking links, emails, etc.)
FRONTEND_URL=https://bsctextiles.in
TRACKING_URL=https://bsctextiles.in/track

# Redis (Optional - for sessions, rate limiting, caching)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_URL=
ENABLE_REDIS=false

# External AI Integrations (Server-side ONLY)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email Configuration (Resend - primary)
RESEND_API_KEY=
RESEND_FROM_NAME=BSC Textiles
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email Configuration (SMTP - fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Email Configuration (Legacy fallback names)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=BSC Textiles
EMAIL_FROM_ADDRESS=

# Default Account Passwords (initial seeding only - must be changed immediately)
ADMIN_PASSWORD=
DEFAULT_USER_PASSWORD=
GREETER_PASSWORD=

# API Key Encryption Key (optional, falls back to ENCRYPTION_KEY/JWT_SECRET)
API_KEY_KEK=