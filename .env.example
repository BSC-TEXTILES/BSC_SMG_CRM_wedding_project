# Application Configuration
NODE_ENV=development
PORT=5000

# Security Settings
# Generate strong 64-character random strings for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_INDEPENDENT_64_CHAR_RANDOM_STRING
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_ENCRYPTION_KEY
COOKIE_SECURE=false

# Token Lifetimes (Access Token: 15 minutes max, Refresh Token: 7 days max)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated, NO wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=hrms_db
DB_PORT=3306

# Redis (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload Directory (Persistent path outside web root)
UPLOAD_DIR=./uploads

# Default Account Passwords (initial seeding only - must be changed immediately)
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
DEFAULT_USER_PASSWORD=your_secure_default_user_password_min_12_chars
GREETER_PASSWORD=your_secure_greeter_password_min_12_chars

# External AI Configuration (Server-side only, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here
