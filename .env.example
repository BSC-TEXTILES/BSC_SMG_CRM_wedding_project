# Application Configuration
NODE_ENV=development
PORT=5000

# Security Settings
# Generate a strong 64-character random string for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
SESSION_HOURS=6

# Database Configuration
# Local Development
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hrms_db
DB_PORT=3306

# Production Database (Hostinger Example)
# DB_HOST=localhost
# DB_USER=u123456789_bsc
# DB_PASSWORD=your_strong_password
# DB_NAME=u123456789_hrms

# Default Account Passwords (used during initial seeding only)
ADMIN_PASSWORD=changeme
DEFAULT_USER_PASSWORD=changeme
GREETER_PASSWORD=changeme

# Gemini AI Configuration (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here
